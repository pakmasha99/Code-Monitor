# Database
DATABASE_URL=postgresql://lab:lab123@localhost:5432/code_monitor
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab123
POSTGRES_DB=code_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional, leave empty for local dev

# LLM APIs
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM for Code Analysis
LLM_MODEL=claude-3-5-sonnet-20241022
# Alternative: gpt-4-turbo-preview

# Git Configuration
GIT_CLONE_DIR=/tmp/repos
GIT_SYNC_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application
APP_NAME=Code-Monitor
APP_ENV=development
SECRET_KEY=your_secret_key_change_in_production
DEBUG=True

# Dashboard
DASHBOARD_PORT=8501
API_PORT=8000

# Ranking Weights
WEIGHT_CODE_CONTRIBUTION=0.4
WEIGHT_DOCUMENTATION=0.3
WEIGHT_CODE_QUALITY=0.2
WEIGHT_KNOWLEDGE_SHARING=0.1
